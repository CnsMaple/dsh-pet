{
  "name": "dsh-pet",
  "version": "0.4.0",
  "description": "Maid DeepSeek Sticker 版 dsh-pet（fork 自 PC2005-cloud/dsh-pet）：在 DeepSeek Harness 里的贴纸女仆桌宠。",
  "icon": "dsh-pet/assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "web-ui",
    "cordis",
    "react"
  ],
  "homepage": "https://github.com/CnsMaple/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CnsMaple/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/CnsMaple/dsh-pet/issues"
  },
  "type": "module",
  "main": "dsh-pet/lib/index.js",
  "bin": {
    "dsh-pet-standalone": "dsh-pet/lib/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./dsh-pet/lib/types/index.d.ts",
      "default": "./dsh-pet/lib/index.js"
    },
    "./client": {
      "types": "./dsh-pet/lib/types/client/index.d.ts",
      "default": "./dsh-pet/lib/client.js"
    },
    "./src/*": "./dsh-pet/src/*",
    "./cordis.patch.yml": "./dsh-pet/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-pet/lib",
    "dsh-pet/src",
    "dsh-pet/runtime/electron-helper",
    "dsh-pet/assets/webm",
    "dsh-pet/assets/fonts",
    "dsh-pet/assets/pic",
    "dsh-pet/assets/memes",
    "dsh-pet/assets/sound",
    "dsh-pet/assets/config.jsonc",
    "dsh-pet/assets/logo.png",
    "dsh-pet/cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-pet/cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.2-alpha.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
